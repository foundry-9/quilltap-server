# CI Dockerfile — uses pre-built JS artifacts from the build-app CI job
#
# The build context must include a 'prebuild/' directory containing:
#   prebuild/.next/standalone/    (Next.js standalone server output)
#   prebuild/.next/static/        (hashed static assets)
#   prebuild/plugins/dist/        (built plugin bundles)
#
# These are produced by the build-app CI job and downloaded as artifacts.
# This Dockerfile skips the expensive next build / plugin build entirely
# and only installs production node_modules for Debian/glibc (compiling
# node-pty; the SQLCipher driver and sharp ship prebuilt binaries).
#
# For local builds, use the standard Dockerfile instead.

# --- Production dependencies (Debian bookworm-slim / glibc on Node 24 LTS) ---
FROM node:24-bookworm-slim AS deps-prod
WORKDIR /app

# Refresh package index and apply security patches
RUN apt-get update \
    && apt-get -y upgrade \
    && rm -rf /var/lib/apt/lists/*

# Install build dependencies for node-pty (no Linux prebuild). The SQLCipher
# driver ships prebuilt Node-API binaries and needs no compiler.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY scripts/fix-node-pty-permissions.js scripts/sync-pdf-worker.js ./scripts/
RUN npm ci --omit=dev && npm rebuild

# --- Production stage ---
FROM node:24-bookworm-slim AS production
WORKDIR /app

# Refresh package index and apply security patches
RUN apt-get update \
    && apt-get -y upgrade \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV DOCKER_CONTAINER=true

# Create non-root user (Debian groupadd/useradd, not Alpine busybox addgroup/adduser)
RUN groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs --no-create-home --shell /usr/sbin/nologin nextjs

# Create data directories (data, files, logs, plugins/npm)
RUN mkdir -p /app/quilltap/data /app/quilltap/files /app/quilltap/logs /app/quilltap/plugins/npm && \
    chown -R nextjs:nodejs /app/quilltap

# Copy pre-built JS artifacts from CI build-app job
COPY --chown=nextjs:nodejs prebuild/.next/standalone/ ./
COPY --chown=nextjs:nodejs prebuild/.next/static/ ./.next/static

# Copy public assets from the repo checkout (not from prebuild)
COPY public ./public

# Copy plugins from CI build-app job
COPY --chown=nextjs:nodejs prebuild/plugins/dist/ ./plugins/dist

# Drop the plugins' own node_modules — esbuild bundles every dependency into each
# plugin's index.js, so these trees are dead weight the moment the build finishes
# (~683 MB across the 14 plugins, and a pile of scanner findings for SDK copies
# that are never loaded). The regular Dockerfile does this in its builder stage;
# the CI path copies prebuilt artifacts wholesale, so it has to strip them here.
RUN rm -rf /app/plugins/dist/*/node_modules

# Copy package files for native module dependencies
COPY package.json package-lock.json ./

# Install runtime tools:
#   - zip + unzip — backup/restore (lib/backup/restore/archive.ts and
#     lib/backup/backup-service.ts shell out to `unzip` / `zip`)
#   - bash — required by Ariel's terminal (PTY hard-codes /bin/bash)
#
# git/curl/wget/jq removed for CVE surface — see the matching block in Dockerfile
# for the full rationale. The `curl` *tool* is qtap-plugin-curl (Node fetch()), so
# it is unaffected.
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash zip unzip \
    && rm -rf /var/lib/apt/lists/*

# Copy production node_modules from the build stage (node-pty already compiled)
COPY --from=deps-prod /app/node_modules ./node_modules

# Keep only this image's SQLCipher driver prebuild. better-sqlite3-multiple-ciphers
# ships eight per-platform binaries plus its compile-time sources; the loader
# only ever reads lib/ and prebuilds/<platform>-<arch>.node. Each arch builds on
# a native runner, so process.arch is the image's arch. Fails the build if the
# expected prebuild is missing.
RUN node -e "const fs=require('fs'),p=require('path');const d='node_modules/better-sqlite3';const keep='linux-'+process.arch+'.node';const pb=p.join(d,'prebuilds');if(!fs.existsSync(p.join(pb,keep))){console.error('missing SQLCipher prebuild '+keep);process.exit(1)}for(const f of fs.readdirSync(pb))if(f!==keep)fs.rmSync(p.join(pb,f));for(const x of ['deps','src','binding.gyp'])fs.rmSync(p.join(d,x),{recursive:true,force:true});console.log('kept '+keep)"

# Bundle the quilltap CLI for in-container debugging. CLI deps resolve via
# Node's module resolution up to /app/node_modules — see Dockerfile for the
# matching block in the regular build pipeline.
COPY --chown=nextjs:nodejs packages/quilltap ./packages/quilltap
RUN ln -s /app/packages/quilltap/bin/quilltap.js /usr/local/bin/quilltap

# Copy entrypoint script
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# --- Attack-surface reduction (must stay LAST: no apt-get or npm may follow) ---
# Strips npm/npx/corepack/yarn (1 CRITICAL + 6 HIGH from npm's own bundled
# node_modules; nothing at runtime shells out to them) and Debian's perl (2
# CRITICAL + 2 HIGH, no fix in bookworm or trixie). See Dockerfile for the full
# rationale — keep the two files in lockstep.
RUN rm -rf /usr/local/lib/node_modules/npm \
           /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-v* \
    && dpkg --purge --force-remove-essential --force-depends \
           perl perl-base perl-modules-5.36 libperl5.36 2>/dev/null || true

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NODE_OPTIONS="--max-old-space-size=4096"

ENTRYPOINT ["entrypoint.sh"]
CMD ["node", "server.js"]
