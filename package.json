{
  "name": "@foundry-9/quilltap",
  "version": "4.12.0-dev.18",
  "private": true,
  "author": {
    "name": "Charles Sebold",
    "email": "charles.sebold@foundry-9.com",
    "url": "https://foundry-9.com"
  },
  "description": "Self-hosted AI workspace for writers, worldbuilders, and roleplayers",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foundry-9/quilltap-server.git"
  },
  "scripts": {
    "build": "npm run build:next",
    "build:docker": "tsx scripts/build-push-docker.ts",
    "build:next": "npm run build:plugins && next build",
    "build:package": "tsx scripts/build-quilltap-package.ts",
    "build:standalone": "node scripts/build-standalone-tarball.mjs",
    "build:plugins": "tsx scripts/build-plugins.ts",
    "deploy:dev": "./cicd/deploy.sh",
    "dev": "tsx server.ts",
    "dev:next": "next dev --turbopack",
    "devssl": "next dev --experimental-https --experimental-https-key ./certs/localhost-key.pem --experimental-https-cert ./certs/localhost.pem",
    "generate:schemas": "tsx scripts/generate-plugin-manifest-schema.ts",
    "generate:icon-css": "tsx scripts/generate-icon-css.ts",
    "generate:emoji-index": "tsx scripts/generate-emoji-index.ts",
    "generate:unicode-index": "tsx scripts/generate-unicode-index.ts",
    "lint": "eslint . && node scripts/check-quilltap-spelling.mjs && node scripts/check-qt-classes.mjs",
    "lint:fix": "eslint . --fix && node scripts/check-quilltap-spelling.mjs",
    "oneoff:cleanup-old-files-v1.6": "tsx scripts/cleanup-old-files.ts",
    "oneoff:theme-convert-v2.8": "tsx scripts/convert-theme-to-module.ts",
    "oneoff:theme-convert-v2.8:all": "tsx scripts/convert-theme-to-module.ts --all",
    "oneoff:theme-convert-v2.8:dry-run": "tsx scripts/convert-theme-to-module.ts --all --dry-run",
    "postinstall": "node scripts/fix-node-pty-permissions.js && node scripts/sync-pdf-worker.js",
    "start": "NODE_ENV=production tsx server.ts",
    "start:docker": "tsx scripts/start-quilltap-docker.ts",
    "stop:docker": "docker stop quilltap && docker rm quilltap",
    "test": "cross-env LOG_LEVEL=error npm run test:all",
    "test:all": "cross-env LOG_LEVEL=error node --no-sparkplug node_modules/jest/bin/jest.js && cross-env LOG_LEVEL=error node --no-sparkplug node_modules/jest/bin/jest.js --config jest.integration.config.ts",
    "test:coverage": "node --no-sparkplug node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "cross-env LOG_LEVEL=error node --no-sparkplug node_modules/jest/bin/jest.js --config jest.integration.config.ts",
    "test:unit": "cross-env NODE_ENV=test LOG_LEVEL=error node --no-sparkplug node_modules/jest/bin/jest.js",
    "test:watch": "node --no-sparkplug node_modules/jest/bin/jest.js --watch",
    "update:npm": "./scripts/upgrade-dependencies.sh",
    "update:version": "./scripts/update_version.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hpcc-js/wasm-graphviz": "^1.30.0",
    "@lexical/code": "^0.53.0",
    "@lexical/link": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/markdown": "^0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/selection": "^0.53.0",
    "@lexical/table": "^0.53.0",
    "@msgpack/msgpack": "^3.1.3",
    "@quilltap/plugin-types": "^2.10.0",
    "@quilltap/plugin-utils": "^2.7.3",
    "@svar-ui/react-filemanager": "2.6.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "croner": "^11.0.0",
    "dompurify": "^3.4.17",
    "jsonrepair": "^3.15.0",
    "katex": "^0.19.1",
    "lexical": "^0.53.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.3",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "openai": "^7.45.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "svg2roughjs": "^3.2.3",
    "tar": "^7.5.22",
    "unified": "^11.0.5",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@openrouter/sdk": "^1.5.21",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "emojibase-data": "^17.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-fetch-mock": "^4.2.0",
    "js-tiktoken": "^1.0.21",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": "^12.0.0",
    "cookie": "^0.7.0",
    "sharp": "$sharp",
    "fast-uri": "^3.1.5",
    "postcss": "$postcss",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "node-pty@1.1.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "better-sqlite3-multiple-ciphers": false,
    "@openrouter/sdk@1.5.21": true
  }
}
