#compdef quilltap

# Zsh completion for quilltap

# Position is worked out by _arguments, never by counting words. A hard-coded
# `CURRENT == 2` test means the verb only completes when it sits immediately
# after the subcommand, so `quilltap docs --instance Friday <TAB>` offers
# nothing at all. Every function below hands its option list *and* its
# positional specs to one `_arguments -C` call and branches on $state, so flags
# may appear anywhere the CLI itself accepts them.

local ret=1

_quilltap() {
  local -a subcommands
  local -a global_options

  # The whole command line, kept before _arguments rebases `words` for the
  # subcommand dispatch. The lookup helpers read it so that an --instance
  # typed anywhere picks which database they query.
  local -a _quilltap_line
  local -i _quilltap_cword
  _quilltap_line=("${words[@]}")
  _quilltap_cword=$CURRENT

  global_options=(
    '(-d --data-dir)'{-d,--data-dir}'[Data directory]:directory:_directories'
    '(-i --instance)'{-i,--instance}'[Use a registered instance]:instance:_quilltap_instance_names'
    '(-p --port)'{-p,--port}'[Port to listen on]:port:'
    '(-o --open)'{-o,--open}'[Open browser after server starts]'
    '(-v --version)'{-v,--version}'[Show version number]'
    '(-h --help)'{-h,--help}'[Show help message]'
    '--update[Force re-download of application files]'
    '--passphrase[Database passphrase]:passphrase:'
  )

  subcommands=(
    'db:Query encrypted databases'
    'docs:Inspect, read, and export document mounts'
    'sync:Mirror a database-backed store to a directory'
    'themes:Manage theme bundles'
    'instances:Register or inspect named Quilltap instances'
    'memories:Search, browse, and graph memories'
    'memory-diff:Dump existing memories and dry-run re-extraction'
    'recall-replay:Replay a turn'\''s memory recall, old vs episodic ranking'
    'logs:Tail or print an instance log file'
    'migrations:Inspect migration status'
    'maintenance:Run retention/cleanup sweeps'
    'file-verify:Force-download cloud-evicted data files'
    'completion:Generate shell completion scripts'
  )

  # (-) on both positionals stops the top-level _arguments from swallowing a
  # flag typed *after* the subcommand: without it `quilltap docs --instance
  # Friday <TAB>` parses --instance as a global option, leaving the rest-arg
  # array empty and the subcommand dispatch with nothing to dispatch on.
  _arguments -C \
    "${global_options[@]}" \
    '(-): :->subcommand' \
    '(-)*::arg:->args'

  case "$state" in
    subcommand)
      _describe 'command' subcommands
      ;;
    args)
      _quilltap_subcommand
      ;;
  esac

  return ret
}

_quilltap_subcommand() {
  local subcommand="$words[1]"

  case "$subcommand" in
    db)
      _quilltap_db
      ;;
    docs)
      _quilltap_docs
      ;;
    sync)
      _quilltap_sync
      ;;
    themes)
      _quilltap_themes
      ;;
    instances)
      _quilltap_instances
      ;;
    memories)
      _quilltap_memories
      ;;
    memory-diff)
      _quilltap_memory_diff
      ;;
    recall-replay)
      _quilltap_recall_replay
      ;;
    logs)
      _quilltap_logs
      ;;
    migrations)
      _quilltap_migrations
      ;;
    maintenance)
      _quilltap_maintenance
      ;;
    file-verify)
      _quilltap_file_verify
      ;;
    completion)
      _quilltap_completion
      ;;
  esac
}

_quilltap_db() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  local -a subverbs db_opts

  subverbs=(
    'schema:Show database schema'
    'find:Find entities by name'
    'chats:Find chats'
    'messages:Find messages in a chat'
    'logs:Get LLM request logs'
    'message:Get a single message'
    'log:Get a single LLM log entry'
    'memories:List memories for a character'
    'characters:Per-character vault status report'
    'optimize:Optimize database'
    'backup:Backup database'
    'integrity:Check database integrity'
  )

  db_opts=(
    '(-i --instance)'{-i,--instance}'[Registered instance name]:instance:_quilltap_instance_names'
    '(-d --data-dir)'{-d,--data-dir}'[Data directory]:directory:_directories'
    '--passphrase[Database passphrase]:passphrase:'
    '--json[JSON output]'
    '--limit[Result limit]:limit:'
    '--grep[Substring search]:text:'
    '--character[Character name or id]:character:'
    '--project[Project name or id]:project:'
    '--about[Subject character]:character:'
    '--source[Memory source]:source:(AUTO MANUAL)'
    '--chat[Chat name or id]:chat:'
    '--message[Message id]:id:'
    '--rendered[Render rich content]'
    '--field[Log field]:field:(request response both)'
    '--tail[Tail N rows]:n:'
    '--last[Last N items]:n:'
    '--full[Full output]'
    '--from[Participant filter]:participant:'
    '--type[Filter by type]:type:'
    '--out[Output directory]:path:_files -/'
    '--id[Single character by name or id]:character:'
    '--diverged[Only characters whose DB and vault differ]'
    '--blocked[Only characters with vault issues]'
    '--tables[List tables (low-level)]'
    '--count[Count rows in table]:table:'
    '--repl[Open SQL REPL (read-only unless --write)]'
    '--write[Open database read-write (lock-gated; refuses if an instance holds the lock)]'
    '--llm-logs[Target llm-logs database]'
    '--mount-points[Target mount-index database]'
    '--lock-status[Show instance lock status]'
    '--lock-clean[Clean stale lock]'
    '--lock-override[Override active lock]'
    '(-h --help)'{-h,--help}'[Show help]'
  )

  # (-) again: a flag typed after the verb belongs to the verb's own
  # _arguments call below, not to this one.
  _arguments -C $db_opts \
    '(-): :->verb' \
    '(-)*::arg:->rest'

  case "$state" in
    verb)
      _describe -t commands 'db subcommand' subverbs
      ;;
    rest)
      case "$line[1]" in
        characters)
          _quilltap_db_characters
          ;;
        *)
          # Nothing to complete positionally, but the flags still apply.
          _arguments $db_opts
          ;;
      esac
      ;;
  esac
}

