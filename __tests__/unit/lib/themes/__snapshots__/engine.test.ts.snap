  --qt-scrollbar-thumb: color-mix(in srgb, var(--p-gold) 60%, transparent);
  --qt-scrollbar-track: transparent;
  --qt-color-scheme: light;
}

[data-theme="v2-sample"].dark {
  --p-gold: #F4BE34;
  --p-ink: hsl(40 20% 90%);
  --theme-background: hsl(30 15% 9%);
  --theme-category-character: hsl(200 60% 60%);
  --qt-card-shadow: 0 1px 3px rgb(0 0 0 / 0.4);
  --qt-page-background-image: url("/api/themes/assets/bundle:v2-sample/textures/paper-dark.webp?v=1.0.0");
  --qt-color-scheme: dark;
}
"
