          },
          {
            "id": "b1a0c001-1001-4001-a001-100000000008",
            "characterId": "a42c02d7-90b8-49da-b7fa-c5f31894afd7",
            "title": "Hair brushed back",
            "description": "His usual and only arrangement: brushed neatly back from the forehead, with nothing in it.",
            "imagePrompt": "hair brushed neatly back from a high forehead",
            "types": [
              "hair"
            ],
            "componentItemIds": [],
            "appropriateness": "any",
            "isDefault": true,
            "replace": false,
            "migratedFromClothingRecordId": null,
