{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "scripts/*.ts",
    "migrations/*.ts",
    "jest.integration.config.ts",
    "lib/database/index.ts"
  ],
  "project": [
    "**/*.{ts,tsx}",
    "!packages/**",
    "!plugins/**"
  ],
  "ignore": [
    "packages/**",
    "lib/background-jobs/child/child-entry.ts",
    "__tests__/helpers/lexicalPluginHarness.tsx",
    "**/*.d.ts"
  ],
  "ignoreDependencies": [
    "@types/*",
    "ts-node",
    "esbuild",
    "better-sqlite3-multiple-ciphers",
    "@anthropic-ai/sdk"
  ],
  "ignoreBinaries": [
    "tasklist"
  ]
}
