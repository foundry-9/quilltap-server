          {
            "id": "b1a0c002-2001-4001-a001-200000000003",
            "characterId": "f11db2bc-8cfe-4beb-a1b8-91f4c4ba9f23",
            "title": "Work boots",
            "description": "Brown leather ankle boots with steel toes and thick soles, scuffed and well kept, laced tight. She trusts them over any chair for standing on.",
            "imagePrompt": "scuffed brown leather ankle work boots, laced tight",
            "types": [
              "footwear"
            ],
            "componentItemIds": [],
