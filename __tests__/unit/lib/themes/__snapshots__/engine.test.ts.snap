exports[`compiled CSS (3.2, 3.3) scopes the custom CSS 1`] = `
"@scope ([data-theme="v2-sample"]) to ([data-theme]:not([data-theme="v2-sample"])) {

:scope {
  --sample-glow: 0 0 6px var(--p-gold);
}

:scope.dark .qt-card {
  border-color: var(--p-gold);
}

:scope body {
  letter-spacing: 0.01em;
}

:scope .qt-homepage-section::before {
  content: "";
  background-image: url("/api/themes/assets/bundle:v2-sample/textures/paper.webp?v=1.0.0");
  opacity: 0.2;
}
}

@keyframes v2-sample-glow {
  from { box-shadow: none; }
  to { box-shadow: var(--sample-glow); }
}

@scope ([data-theme="v2-sample"]) to ([data-theme]:not([data-theme="v2-sample"])) {

:scope .qt-button-primary:hover {
  animation: v2-sample-glow 1.2s ease-in-out infinite alternate;
}
}

@media (max-width: 640px) {
  @scope ([data-theme="v2-sample"]) to ([data-theme]:not([data-theme="v2-sample"])) {
  :scope .qt-card {
    padding: 0.75rem;
  }
}
}
"
`;

