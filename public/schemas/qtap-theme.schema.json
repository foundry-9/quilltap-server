{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quilltap.ai/schemas/qtap-theme.schema.json",
  "title": "Quilltap theme manifest (formatVersion 2)",
  "description": "theme.json in a .qtap-theme bundle. Generated from lib/themes/engine/document.ts; the rules that need the bundle itself are checked by `quilltap themes validate`.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "const": "qtap-theme"
    },
    "formatVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z.+-]{1,64}$"
    },
    "author": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "license": {
      "type": "string",
      "pattern": "^(proprietary|[A-Za-z0-9.+\\-]+( (AND|OR|WITH) [A-Za-z0-9.+\\-]+)*)$"
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "quilltapVersion": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "supportsDarkMode": {
      "default": true,
      "type": "boolean"
    },
    "previewImage": {
      "type": "string",
      "minLength": 1
    },
    "tokensPath": {
      "default": "tokens.json",
      "type": "string",
      "minLength": 1
    },
    "stylesPath": {
      "type": "string",
      "minLength": 1
    },
    "fonts": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "src": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "string",
            "pattern": "^(normal|bold|[1-9]00|[1-9]00 [1-9]00)$"
          },
          "style": {
            "type": "string",
            "enum": [
              "normal",
              "italic",
              "oblique"
            ]
          },
          "display": {
            "type": "string",
            "enum": [
              "auto",
              "block",
              "swap",
              "fallback",
              "optional"
            ]
          },
          "license": {
            "type": "string",
            "pattern": "^(proprietary|[A-Za-z0-9.+\\-]+( (AND|OR|WITH) [A-Za-z0-9.+\\-]+)*)$"
          },
          "licenseFile": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "family",
          "src",
          "license"
        ],
        "additionalProperties": false
      }
    },
    "icons": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "subsystems": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "thumbnail": {
            "anyOf": [
              {
                "type": "string",
                "const": "none"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "backgroundImage": {
            "anyOf": [
              {
                "type": "string",
                "const": "none"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "hooksVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "name",
    "version",
    "author"
  ],
  "additionalProperties": false
}
