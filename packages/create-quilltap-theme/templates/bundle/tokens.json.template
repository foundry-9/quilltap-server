{
  "$schema": "https://quilltap.ai/schemas/qtap-theme-tokens.schema.json",
  "choices": {
    "density": "comfortable"
  },
  "primitives": {
    "brand": {
      "type": "color",
      "value": "{{PRIMARY_COLOR}}",
      "dark": "color-mix(in srgb, {{PRIMARY_COLOR}} 70%, white)"
    },
    "paper": {
      "type": "color",
      "value": "hsl(40 30% 97%)",
      "dark": "hsl(220 15% 12%)"
    },
    "ink": {
      "type": "color",
      "value": "hsl(220 20% 15%)",
      "dark": "hsl(40 20% 92%)"
    },
    "line": {
      "type": "color",
      "value": "hsl(40 15% 85%)",
      "dark": "hsl(220 12% 24%)"
    }
  },
  "tokens": {
    "--theme-background": "var(--p-paper)",
    "--theme-foreground": "var(--p-ink)",
    "--theme-primary": "var(--p-brand)",
    "--theme-primary-foreground": {
      "value": "hsl(0 0% 100%)",
      "dark": "hsl(220 20% 10%)"
    },
    "--theme-ring": "var(--p-brand)",
    "--theme-border": "var(--p-line)",
    "--theme-radius-md": "10px"
  }
}
