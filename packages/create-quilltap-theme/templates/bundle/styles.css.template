/*
 * Custom CSS for this theme. Most of a theme belongs in tokens.json; reach
 * for CSS only for what no token covers. Write selectors against the app's
 * hooks (the qt-* classes listed in THEME_HOOKS.md) and leave the theme id
 * out: Quilltap scopes every rule to this theme when it loads it.
 *
 * Token values are available as var(--theme-*), var(--qt-*) and, for this
 * theme's own primitives, var(--p-<name>).
 */

/* Section titles are set in the serif. */
.qt-section-title {
  font-family: var(--font-serif);
}

/* A card's outline takes a touch of the brand colour under the pointer. */
.qt-card-interactive:hover {
  border-color: color-mix(in srgb, var(--p-brand) 40%, transparent);
}
