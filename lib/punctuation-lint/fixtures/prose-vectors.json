{
  "description": "Prose-mode contract corpus for lib/punctuation-lint/engine.ts (the no-dialogue rule under proseMode, and classifyProse). quilltap-v5 copies this byte-for-byte and asserts identical output.",
  "lint": [
    {
      "name": "narration only lights up every narrated run",
      "blocks": [
        "She set the cup down.\n\nHe did not look up."
      ],
      "expect": [
        {
          "block": 0,
          "start": 0,
          "end": 21,
          "rule": "no-dialogue"
        },
        {
          "block": 0,
          "start": 23,
          "end": 42,
          "rule": "no-dialogue"
        }
      ]
    },
    {
      "name": "a forgotten quote: a spoken sentence typed as narration",
      "blocks": [
        "You came, Theo said."
      ],
      "expect": [
        {
          "block": 0,
          "start": 0,
          "end": 20,
          "rule": "no-dialogue"
        }
      ]
    },
    {
      "name": "one opening quote anywhere clears it",
      "blocks": [
        "She set the cup down.",
        "\"You came"
      ],
      "expect": [
        {
          "block": 1,
          "start": 0,
          "end": 1,
          "rule": "unclosed-dialogue"
        }
      ]
    },
    {
      "name": "an opening quote just typed clears it",
      "blocks": [
        "He said \""
      ],
      "caret": {
        "block": 0,
        "offset": 9
      },
      "expect": []
    },
    {
      "name": "a quote inside an aside is not dialogue",
      "blocks": [
        "She waits. ((He said \"brb\" earlier))"
      ],
      "expect": [
        {
          "block": 0,
          "start": 0,
          "end": 10,
          "rule": "no-dialogue"
        }
      ]
    },
    {
      "name": "an aside alone is not narration",
      "blocks": [
        "((brb, dinner))"
      ],
      "expect": []
    },
    {
      "name": "a scene break alone is not narration",
      "blocks": [
        "* * *"
      ],
      "expect": []
    },
    {
      "name": "an empty draft says nothing",
      "blocks": [
        ""
      ],
      "expect": []
    },
    {
      "name": "code blocks are not narration",
      "blocks": [
        null,
        "Plain words."
      ],
      "expect": [
        {
          "block": 1,
          "start": 0,
          "end": 12,
          "rule": "no-dialogue"
        }
      ]
    },
    {
      "name": "emphasis inside narration is still narration",
      "blocks": [
        "He was *very* late."
      ],
      "expect": [
        {
          "block": 0,
          "start": 0,
          "end": 19,
          "rule": "no-dialogue"
        }
      ]
    }
  ],
  "classify": [
    {
      "name": "narration around dialogue",
      "blocks": [
        "She smiled. \"You came,\" she said. \"Finally.\""
      ],
      "expect": [
        {
          "block": 0,
          "start": 0,
          "end": 11,
          "kind": "narration"
        },
        {
          "block": 0,
          "start": 24,
          "end": 33,
          "kind": "narration"
        }
      ]
    },
    {
      "name": "unclosed dialogue runs to paragraph end",
      "blocks": [
        "\"I never thought\n\nHe paused."
      ],
      "expect": [
        {
          "block": 0,
          "start": 18,
          "end": 28,
          "kind": "narration"
        }
      ]
    },
    {
      "name": "an aside, closed and unclosed",
      "blocks": [
        "She waits. ((brb)) Then she sits. ((and"
      ],
      "expect": [
        {
          "block": 0,
          "start": 0,
          "end": 10,
          "kind": "narration"
        },
        {
          "block": 0,
          "start": 11,
          "end": 18,
          "kind": "ooc"
        },
        {
          "block": 0,
          "start": 19,
          "end": 33,
          "kind": "narration"
        },
        {
          "block": 0,
          "start": 34,
          "end": 39,
          "kind": "ooc"
        }
      ]
    },
    {
      "name": "a quote inside an aside does not open dialogue",
      "blocks": [
        "((he said \"hi\")) She nods."
      ],
      "expect": [
        {
          "block": 0,
          "start": 0,
          "end": 16,
          "kind": "ooc"
        },
        {
          "block": 0,
          "start": 17,
          "end": 26,
          "kind": "narration"
        }
      ]
    },
    {
      "name": "scene break is not narration",
      "blocks": [
        "End.\n\n* * *\n\nBegin."
      ],
      "expect": [
        {
          "block": 0,
          "start": 0,
          "end": 4,
          "kind": "narration"
        },
        {
          "block": 0,
          "start": 13,
          "end": 19,
          "kind": "narration"
        }
      ]
    },
    {
      "name": "soft line breaks stay in one run",
      "blocks": [
        "He sat.\nShe stood."
      ],
      "expect": [
        {
          "block": 0,
          "start": 0,
          "end": 18,
          "kind": "narration"
        }
      ]
    },
    {
      "name": "narration in a second block",
      "blocks": [
        "\"Hello.\"",
        "She waved."
      ],
      "expect": [
        {
          "block": 1,
          "start": 0,
          "end": 10,
          "kind": "narration"
        }
      ]
    },
    {
      "name": "code block is skipped",
      "blocks": [
        null,
        "Words."
      ],
      "expect": [
        {
          "block": 1,
          "start": 0,
          "end": 6,
          "kind": "narration"
        }
      ]
    }
  ]
}
