{
  "$schema": "https://quilltap.ai/schemas/qtap-theme.schema.json",
  "format": "qtap-theme",
  "formatVersion": 2,
  "id": "earl-grey",
  "name": "Earl Grey",
  "description": "A high-contrast dark theme inspired by modern AI chat interfaces, with pure black sidebar, charcoal main area, and clean minimal styling",
  "version": "2.0.0",
  "author": "Foundry-9 LLC",
  "license": "MIT",
  "tags": [
    "earl-grey",
    "dark",
    "minimal",
    "high-contrast",
    "modern"
  ],
  "supportsDarkMode": true,
  "tokensPath": "tokens.json",
  "stylesPath": "styles.css",
  "hooksVersion": 1,
  "fonts": [
    {
      "family": "Rethink Sans",
      "src": "fonts/RethinkSans-latin.woff2",
      "weight": "400 700",
      "style": "normal",
      "display": "swap",
      "license": "OFL-1.1",
      "licenseFile": "fonts/OFL.txt"
    },
    {
      "family": "Rethink Sans",
      "src": "fonts/RethinkSans-latin-ext.woff2",
      "weight": "400 700",
      "style": "normal",
      "display": "swap",
      "license": "OFL-1.1",
      "licenseFile": "fonts/OFL.txt"
    }
  ]
}
