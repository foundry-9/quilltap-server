#!/bin/bash

# Bash completion for quilltap
# Source this file or place it in /etc/bash_completion.d/ or ~/.bash_completion.d/

# Fill COMPREPLY from newline-separated candidates on stdin. Store and
# instance names routinely contain spaces ("Project Files: The Estate"), which
# `compgen -W` would chop into separate candidates.
_quilltap_lines_compreply() {
  local cur="$1" line
  local oldifs="$IFS"
  COMPREPLY=()
  IFS=$'\n'
  while read -r line; do
    [[ -n "$line" ]] || continue
    [[ "$line" == "$cur"* ]] && COMPREPLY+=("$(printf '%q' "$line")")
  done
  IFS="$oldifs"
}

# Which docs positionals name a document store, and which name a local path.
# move/copy/link take <srcMount> <srcPath> <dstMount> <dstPath>, so a store is
# wanted at both 2 and 4; every other store-taking verb takes it first.
_quilltap_docs_positional() {
  local verb="$1" argpos="$2" cur="$3"
  local store_verbs=" show files ls dir tree read export scan reindex embed write delete mkdir rmdir mvdir move copy link "

  if [[ "$argpos" == "2" ]] && [[ "$store_verbs" == *" $verb "* ]]; then
    _quilltap_lines_compreply "$cur" \
      <<< "$(command quilltap docs list --names-only "${ctx_flags[@]}" 2>/dev/null)"
    return
  fi

  case "$verb" in
    move|copy|link)
      if [[ "$argpos" == "4" ]]; then
        _quilltap_lines_compreply "$cur" \
          <<< "$(command quilltap docs list --names-only "${ctx_flags[@]}" 2>/dev/null)"
      fi
      ;;
    export)
      # `docs export <mount> <outputDir>` — the second one is a local directory.
      [[ "$argpos" == "3" ]] && COMPREPLY=($(compgen -d -- "$cur"))
      ;;
    write)
      # `docs write <mount> <path> [file]` — the optional source is local.
      [[ "$argpos" == "4" ]] && COMPREPLY=($(compgen -f -- "$cur"))
      ;;
  esac
}

_quilltap_complete() {
  local cur prev words cword
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  words=("${COMP_WORDS[@]}")
  cword=$COMP_CWORD

  # Global options that can appear before subcommands
  local global_opts="-d --data-dir -i --instance -p --port -o --open -v --version -h --help --update --passphrase"

  # Top-level subcommands
  local top_cmds="db docs sync themes instances memories memory-diff recall-replay logs migrations maintenance file-verify completion"

  # Flags that swallow the word after them. A flat list will not do: -o is the
  # valueless global --open but themes' valued --output, and `memories`
  # reserves -i for --ignore-case rather than --instance. Counting those wrong
  # makes a flag's value look like the subcommand's verb, which is how
  # `quilltap docs --limit 5 <TAB>` used to lose the verb list.
  local vf_global=" -d --data-dir -i --instance -p --port --passphrase "
  local vf_db=" --limit --grep --character --project --about --source --chat --message --field --tail --last --from --type --out --id --count "
  local vf_docs=" --mount --folder --type --ext --limit --max --context --top --threshold --sort --depth --max-nodes --format "
  local vf_sync=" --direction --prefer "
  local vf_themes=" -o --output -k --key -n --name "
  local vf_memories=" -d --data-dir --instance --passphrase --port --character --about --source --chat --project --since --until --min-importance --min-reinforced --sort --limit --in --max --context --depth --max-nodes --top --threshold "
  local vf_logs=" --stream --tail --grep "
  local vf_memory_diff=" --concurrency --out "
  local vf_recall_replay=" --turn --char --limit --port "
  local vf_file_verify=" --stall-ms "

  # Get the subcommand (first non-option word after quilltap)
  local subcommand=""
  local subverb=""
  local -a ctx_flags=()
  local positional_count=0
  local i=1
  while [[ $i -lt $cword ]]; do
    local word="${words[$i]}"

    # Which flags take a value depends on the subcommand seen so far; before
    # one is seen, only the global flags are in play.
    local valued="$vf_global"
    case "$subcommand" in
      db)            valued="$vf_global$vf_db" ;;
      docs)          valued="$vf_global$vf_docs" ;;
      sync)          valued="$vf_global$vf_sync" ;;
      themes)        valued="$vf_global$vf_themes" ;;
      memories)      valued="$vf_memories" ;;
      logs)          valued="$vf_global$vf_logs" ;;
      memory-diff)   valued="$vf_global$vf_memory_diff" ;;
      recall-replay) valued="$vf_global$vf_recall_replay" ;;
      file-verify)   valued="$vf_global$vf_file_verify" ;;
    esac

    if [[ "$valued" == *" $word "* ]]; then
      # Remember how the user is addressing an instance so the live lookups
      # below query that database rather than the default one.
      case "$word" in
        -d|--data-dir|-i|--instance|--passphrase)
          if (( i + 1 < cword )); then
            ctx_flags+=("$word" "${words[$((i + 1))]}")
          fi
          ;;
      esac
      # Takes a value, skip the next word
      ((i += 2))
      continue
    fi

    case "$word" in
      -*)
        # Valueless (or unknown) flag
        ((i += 1))
        ;;
      *)
        if [[ -z "$subcommand" ]]; then
          subcommand="$word"
        elif [[ -z "$subverb" ]]; then
          subverb="$word"
        fi
        # Counts the subcommand itself, so the word under the cursor sits at
        # positional_count within the subcommand: 1 is its verb, 2 the verb's
        # first argument, and so on.
        ((positional_count += 1))
        ((i += 1))
        ;;
    esac
  done

  # If we're completing a global flag value
  if [[ "$prev" == "-d" ]] || [[ "$prev" == "--data-dir" ]]; then
    # Complete with directories
    COMPREPLY=($(compgen -d -- "$cur"))
    return
  fi
  if [[ "$prev" == "-p" ]] || [[ "$prev" == "--port" ]] || [[ "$prev" == "--passphrase" ]]; then
    return
  fi
  if [[ "$prev" == "--instance" ]] || { [[ "$prev" == "-i" ]] && [[ "$subcommand" != "memories" ]]; }; then
    _quilltap_lines_compreply "$cur" \
      <<< "$(command quilltap instances list --names-only 2>/dev/null)"
    return
  fi

  # If no subcommand yet, complete with subcommands and global options
  if [[ -z "$subcommand" ]]; then
    if [[ "$cur" == -* ]]; then
      COMPREPLY=($(compgen -W "$global_opts" -- "$cur"))
    else
      COMPREPLY=($(compgen -W "$top_cmds" -- "$cur"))
    fi
    return
  fi

  # Shared flag-value completions for any subcommand
  case "$prev" in
    --mount)
      _quilltap_lines_compreply "$cur" \
        <<< "$(command quilltap docs list --names-only "${ctx_flags[@]}" 2>/dev/null)"
      return
      ;;
    --character|--about)
      # No live source; suggest common literals
      COMPREPLY=($(compgen -W "all self none" -- "$cur"))
      return
      ;;
    --source)
      COMPREPLY=($(compgen -W "AUTO MANUAL" -- "$cur"))
      return
      ;;
    --sort)
      COMPREPLY=($(compgen -W "name time size links reinforced importance created accessed reinforcement-count" -- "$cur"))
      return
      ;;
    --field)
      COMPREPLY=($(compgen -W "request response both" -- "$cur"))
      return
      ;;
    --type)
      COMPREPLY=($(compgen -W "file folder" -- "$cur"))
      return
      ;;
    --stream)
      COMPREPLY=($(compgen -W "combined error stdout stderr startup" -- "$cur"))
      return
      ;;
    --format)
      COMPREPLY=($(compgen -W "args json" -- "$cur"))
      return
      ;;
    --direction)
      COMPREPLY=($(compgen -W "both to-disk to-store" -- "$cur"))
      return
      ;;
    --prefer)
      COMPREPLY=($(compgen -W "newer store disk" -- "$cur"))
      return
      ;;
  esac

  # Subcommand-specific completion
  case "$subcommand" in
    db)
      local db_verbs="schema find chats messages logs message log memories characters optimize backup integrity"
      local db_flags="--instance --data-dir --passphrase --json --limit --grep \
        --character --project --about --source --chat --message --rendered --field \
        --tail --last --full --from --type --out --id --diverged --blocked --help \
        --tables --count --repl --write --llm-logs --mount-points \
        --lock-status --lock-clean --lock-override"
      if [[ -z "$subverb" ]]; then
        if [[ "$cur" == -* ]]; then
          COMPREPLY=($(compgen -W "$db_flags" -- "$cur"))
        else
          COMPREPLY=($(compgen -W "$db_verbs" -- "$cur"))
        fi
      elif [[ "$subverb" == "characters" ]]; then
        local char_verbs="status archives archive rehydrate export"
        local char_flags="--instance --data-dir --passphrase --json --limit --diverged --blocked --id \
          --write -p --port --out --help"
        if [[ "$cur" == -* ]]; then
          COMPREPLY=($(compgen -W "$char_flags" -- "$cur"))
        else
          COMPREPLY=($(compgen -W "$char_verbs" -- "$cur"))
        fi
      else
        COMPREPLY=($(compgen -W "$db_flags" -- "$cur"))
      fi
      ;;
    docs)
      local docs_verbs="list show files ls dir tree read export scan write delete mkdir move copy link rmdir mvdir status docker-mounts find grep reindex embed"
      local docs_flags="--mount --instance --data-dir --passphrase --port --json --help \
        --uri --base64 --force --rendered --links --folder --type --ext --limit --max --context --top --threshold \
        --ignore-case -l --wait -R --recursive --sort -r --reverse --depth --max-nodes --long --semantic \
        --format"
      if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "$docs_flags" -- "$cur"))
      elif [[ -z "$subverb" ]]; then
        COMPREPLY=($(compgen -W "$docs_verbs" -- "$cur"))
      else
        _quilltap_docs_positional "$subverb" "$positional_count" "$cur"
      fi
      ;;
    sync)
      local sync_flags="--dry-run --direction --prefer --no-delete --no-manifest \
        --json --instance --data-dir --passphrase --port --help"
      if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "$sync_flags" -- "$cur"))
      elif [[ "$positional_count" == "1" ]]; then
        _quilltap_lines_compreply "$cur" \
          <<< "$(command quilltap docs list --names-only "${ctx_flags[@]}" 2>/dev/null)"
      else
        COMPREPLY=($(compgen -d -- "$cur"))
      fi
      ;;
    themes)
      local themes_verbs="list install uninstall validate export create search update registry"
      local themes_flags="--instance --data-dir --output -o --help"
      if [[ -z "$subverb" ]]; then
        if [[ "$cur" == -* ]]; then
          COMPREPLY=($(compgen -W "$themes_flags" -- "$cur"))
        else
          COMPREPLY=($(compgen -W "$themes_verbs" -- "$cur"))
        fi
      elif [[ "$subverb" == "registry" ]]; then
        local registry_verbs="list add remove refresh keygen sign"
        local registry_flags="--key -k --name -n --output -o --help"
        if [[ "$cur" == -* ]]; then
          COMPREPLY=($(compgen -W "$registry_flags" -- "$cur"))
        else
          COMPREPLY=($(compgen -W "$registry_verbs" -- "$cur"))
        fi
      else
        COMPREPLY=($(compgen -W "$themes_flags" -- "$cur"))
      fi
      ;;
    instances)
      local inst_verbs="list ls show path where add create remove rm delete set-passphrase passphrase default rename restore-key rebuild-key"
      local inst_flags="--names-only --json --clear --passphrase --no-passphrase --data-dir --force --yes --help"
      if [[ -z "$subverb" ]]; then
        if [[ "$cur" == -* ]]; then
          COMPREPLY=($(compgen -W "$inst_flags" -- "$cur"))
        else
          COMPREPLY=($(compgen -W "$inst_verbs" -- "$cur"))
        fi
      else
        # Most instances verbs take a name as positional; offer registered names
        case "$subverb" in
          show|remove|rm|delete|set-passphrase|passphrase|default|rename|restore-key|rebuild-key)
            local instances=$(command quilltap instances list --names-only 2>/dev/null)
            if [[ "$cur" == -* ]]; then
              COMPREPLY=($(compgen -W "$inst_flags" -- "$cur"))
            else
              COMPREPLY=($(compgen -W "$instances" -- "$cur"))
            fi
            ;;
          *)
            COMPREPLY=($(compgen -W "$inst_flags" -- "$cur"))
            ;;
        esac
      fi
      ;;
    memories)
      local mem_verbs="ls find grep show tree status validate"
      local mem_flags="--character --about --source --chat --project --since --until \
        --min-importance --min-reinforced --has-embedding --no-embedding \
        --sort -r --reverse --limit --full-titles --in --no-related --list \
        --ignore-case -i --paths-only -l --max --context --depth --max-nodes \
        --semantic --top --threshold \
        --instance --data-dir --passphrase --port --json --help"
      if [[ -z "$subverb" ]]; then
        if [[ "$cur" == -* ]]; then
          COMPREPLY=($(compgen -W "$mem_flags" -- "$cur"))
        else
          COMPREPLY=($(compgen -W "$mem_verbs" -- "$cur"))
        fi
      else
        COMPREPLY=($(compgen -W "$mem_flags" -- "$cur"))
      fi
      ;;
    memory-diff)
      local md_flags="--instance --data-dir --passphrase --port --concurrency --out --help"
      COMPREPLY=($(compgen -W "$md_flags" -- "$cur"))
      ;;
    recall-replay)
      local rr_flags="--turn --char --limit --port --json --help"
      COMPREPLY=($(compgen -W "$rr_flags" -- "$cur"))
      ;;
    logs)
      local logs_flags="--stream --tail -f --follow --grep \
        --instance --data-dir --passphrase --help"
      COMPREPLY=($(compgen -W "$logs_flags" -- "$cur"))
      ;;
    migrations)
      local mig_verbs="status pending run"
      local mig_flags="--dry-run --json --instance --data-dir --passphrase --help"
      if [[ -z "$subverb" ]]; then
        if [[ "$cur" == -* ]]; then
          COMPREPLY=($(compgen -W "$mig_flags" -- "$cur"))
        else
          COMPREPLY=($(compgen -W "$mig_verbs" -- "$cur"))
        fi
      else
        COMPREPLY=($(compgen -W "$mig_flags" -- "$cur"))
      fi
      ;;
    maintenance)
      local maint_verbs="status run"
      local maint_flags="--instance --data-dir --passphrase --json --help"
      if [[ -z "$subverb" ]]; then
        if [[ "$cur" == -* ]]; then
          COMPREPLY=($(compgen -W "$maint_flags" -- "$cur"))
        else
          COMPREPLY=($(compgen -W "$maint_verbs" -- "$cur"))
        fi
      else
        COMPREPLY=($(compgen -W "$maint_flags" -- "$cur"))
      fi
      ;;
    file-verify)
      local fv_flags="--all --stall-ms --json --instance --data-dir --help"
      COMPREPLY=($(compgen -W "$fv_flags" -- "$cur"))
      ;;
    completion)
      if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "--help" -- "$cur"))
      else
        COMPREPLY=($(compgen -W "bash zsh fish" -- "$cur"))
      fi
      ;;
  esac
}

complete -F _quilltap_complete quilltap
