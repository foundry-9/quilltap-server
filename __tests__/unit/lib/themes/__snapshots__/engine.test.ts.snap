  --p-line-thin: 1px;
  --theme-primary: var(--p-gold);
  --theme-foreground: var(--p-ink);
  --theme-background: hsl(40 33% 96%);
  --theme-font-sans: "Rethink Sans", system-ui, sans-serif;
  --theme-category-character: hsl(200 60% 45%);
  --qt-card-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
