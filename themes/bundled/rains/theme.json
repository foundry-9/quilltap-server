{
  "$schema": "https://quilltap.ai/schemas/qtap-theme.schema.json",
  "format": "qtap-theme",
  "formatVersion": 2,
  "id": "rains",
  "name": "Rains",
  "description": "A Claude-inspired warm theme with clean charcoal dark mode, parchment light mode, and orange-amber accents",
  "version": "2.0.1",
  "author": "Foundry-9 LLC",
  "license": "MIT",
  "tags": [
    "rains",
    "brown",
    "warm",
    "earthy",
    "cozy"
  ],
  "supportsDarkMode": true,
  "tokensPath": "tokens.json",
  "stylesPath": "styles.css",
  "hooksVersion": 1,
  "fonts": [
    {
      "family": "Nunito Sans",
      "src": "fonts/NunitoSans-Regular.woff2",
      "weight": "400",
      "style": "normal",
      "display": "swap",
      "license": "OFL-1.1",
      "licenseFile": "fonts/OFL.txt"
    },
    {
      "family": "Nunito Sans",
      "src": "fonts/NunitoSans-Italic.woff2",
      "weight": "400",
      "style": "italic",
      "display": "swap",
      "license": "OFL-1.1",
      "licenseFile": "fonts/OFL.txt"
    },
    {
      "family": "Fira Code",
      "src": "fonts/FiraCode-Regular.woff2",
      "weight": "400",
      "style": "normal",
      "display": "swap",
      "license": "OFL-1.1",
      "licenseFile": "fonts/OFL.txt"
    },
    {
      "family": "Fira Code",
      "src": "fonts/FiraCode-Bold.woff2",
      "weight": "700",
      "style": "normal",
      "display": "swap",
      "license": "OFL-1.1",
      "licenseFile": "fonts/OFL.txt"
    }
  ]
}
