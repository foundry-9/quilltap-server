          {
            "id": "b1a0c001-1001-4001-a001-100000000007",
            "characterId": "a42c02d7-90b8-49da-b7fa-c5f31894afd7",
            "title": "Satchel, pencils, and reading glasses",
            "description": "A soft brown leather satchel gone dark at the strap, holding whatever he is reading, a notebook, three sharpened pencils, and a small pocket knife to sharpen them. Slim half-rim reading glasses live in his shirt pocket and are put on with a certain ceremony when a page deserves it.",
