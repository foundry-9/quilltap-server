Dockerfile
.dockerignore
node_modules
plugins/dist/*/node_modules
prebuild/plugins/dist/*/node_modules
npm-debug.log
README.md
.next
.git
.gitignore
features
*.md
.env*.local

# prebuild/ is intentionally NOT excluded — Dockerfile.ci uses it for CI builds.
# Its plugins' node_modules ARE excluded above: esbuild bundles every dependency
# into each plugin's index.js, so the CI artifact's copies are dead weight that
# would otherwise ship in the published image. Dockerfile.ci also rm -rf's them,
# the same belt-and-braces the root Dockerfile uses for plugins/dist.

# Large directories not needed for Docker build
out
coverage
temp
packages
# Dockerfile.ci copies packages/quilltap directly from the build context
# (the regular Dockerfile copies from a builder stage that has the repo cloned in).
!packages/quilltap
packages/quilltap/node_modules
.storybook
storybook-static
__tests__
stories
website
.githooks
.claude
