          {
            "id": "b1a0c002-2001-4001-a001-200000000004",
            "characterId": "f11db2bc-8cfe-4beb-a1b8-91f4c4ba9f23",
            "title": "Cotton kurta over jeans",
            "description": "For days off and days at home: a knee-length block-printed cotton kurta in mustard, indigo, or coral, worn loose over the same jeans with flat leather sandals. It is as near as she comes to dressing down.",
